# Copia este archivo a .env (Docker) o .env.local (pnpm dev) y rellena lo que uses.
# Ninguna variable es obligatoria: sin clave de LLM la app funciona en modo
# reducido, con explicaciones estáticas y un aviso visible en la interfaz.

# --- Tutor (LLM) -------------------------------------------------------------
# Basta con UNA clave. Si hay varias, se usa la primera de esta lista que exista.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcional: fuerza el proveedor cuando hay varias claves: anthropic | openai | google
LLM_PROVIDER=

# --- Límite de peticiones al tutor (opcional) ---------------------------------
# Upstash Redis. Sin estas variables no se aplica rate limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
