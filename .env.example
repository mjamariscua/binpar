# Copia este archivo a .env (Docker) o .env.local (pnpm dev) y rellena lo que uses.
# Ninguna variable es obligatoria: sin clave de LLM la app funciona en modo
# reducido, con explicaciones estáticas y un aviso visible en la interfaz.

# --- Tutor (LLM) -------------------------------------------------------------
# Basta con UNA clave. Si hay varias, se usa la primera de esta lista que exista.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Opcional: fuerza el proveedor cuando hay varias claves: anthropic | openai | google
LLM_PROVIDER=

# Opcional: otro modelo del proveedor elegido. Por defecto, el modelo rápido de cada uno:
# claude-haiku-5-5 (Anthropic), gpt-5.4-mini (OpenAI), gemini-3.5-flash (Google).
LLM_MODEL=

# --- Límite de peticiones al tutor (opcional) ---------------------------------
# Upstash Redis: límite global de 20 peticiones cada 10 min por IP. Sin estas variables
# se aplica el mismo límite en memoria, por proceso (exacto en Docker, orientativo en Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
